<script>
// Показ/скрытие поля размера скидки (для создания)
function toggleDiscountValueFieldCreate() {
    var discountType = document.querySelector('#addCouponModal select[name="discount_type"]').value;
    var valueField = document.getElementById('discountValueFieldCreate');
    var valueInput = valueField.querySelector('input');

    if (discountType === 'wholesale') {
        valueField.style.display = 'none';
        valueInput.required = false;
    } else {
        valueField.style.display = 'block';
        valueInput.required = true;
    }
}

// Показ/скрытие поля пользовательского срока
function toggleCustomValidity() {
    var select = document.querySelector('select[name="validity_period"]');
    var customField = document.getElementById('customValidityField');
    var dateInput = customField.querySelector('input');
    
    if (select.value === 'custom') {
        customField.style.display = 'block';
        dateInput.required = true;
    } else {
        customField.style.display = 'none';
        dateInput.required = false;
    }
}

// Показ/скрытие поля размера скидки (для редактирования)
function toggleDiscountValueField() {
    var discountType = document.getElementById('editDiscountType').value;
    var valueField = document.getElementById('discountValueField');
    var valueInput = document.getElementById('editDiscountValue');

    if (discountType === 'wholesale') {
        valueField.style.display = 'none';
        valueInput.required = false;
    } else {
        valueField.style.display = 'block';
        valueInput.required = true;
    }
}

document.addEventListener('DOMContentLoaded', function() {
    // Обработка кнопки редактирования
    document.querySelectorAll('.edit-coupon-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var id = this.dataset.id;
            var phone = this.dataset.phone;
            var fullName = this.dataset.fullName;
            var discountType = this.dataset.discountType;
            var discountValue = this.dataset.discountValue;
            var isActive = this.dataset.isActive;
            var validUntil = this.dataset.validUntil;

            // Заполняем форму редактирования
            document.getElementById('editCouponId').value = id;
            document.getElementById('editCouponPhone').value = phone;
            document.getElementById('editCouponFullName').value = fullName;

            // Выбираем правильный тип скидки
            var select = document.getElementById('editDiscountType');
            select.value = discountType;

            // Устанавливаем размер скидки
            document.getElementById('editDiscountValue').value = discountValue;
            
            // Устанавливаем статус
            document.getElementById('editIsActive').value = isActive;
            
            // Устанавливаем срок действия
            document.getElementById('editValidUntil').value = validUntil;

            // Показываем/скрываем поле размера скидки
            toggleDiscountValueField();

            // Обновляем action формы
            document.getElementById('editCouponForm').action = '{{ route('admin.customers.update', '__ID__') }}'.replace('__ID__', id);

            // Показываем модальное окно
            var editModal = new bootstrap.Modal(document.getElementById('editCouponModal'));
            editModal.show();
        });
    });

    // Обработка кнопки заблокировать/разблокировать
    document.querySelectorAll('.toggle-block-coupon-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var id = this.dataset.id;
            var isActive = this.dataset.isActive === '1';
            var confirmMsg = isActive ? 'Заблокировать купон?' : 'Разблокировать купон?';
            
            if (confirm(confirmMsg)) {
                // Создаём форму для отправки запроса
                var form = document.createElement('form');
                form.method = 'POST';
                form.action = '{{ url('admin/customers/toggle-block') }}/' + id;
                
                var csrfInput = document.createElement('input');
                csrfInput.type = 'hidden';
                csrfInput.name = '_token';
                csrfInput.value = document.querySelector('meta[name="csrf-token"]').content;
                
                var methodInput = document.createElement('input');
                methodInput.type = 'hidden';
                methodInput.name = '_method';
                methodInput.value = 'PUT';

                var activeInput = document.createElement('input');
                activeInput.type = 'hidden';
                activeInput.name = 'is_active';
                activeInput.value = isActive ? '0' : '1';

                form.appendChild(csrfInput);
                form.appendChild(methodInput);
                form.appendChild(activeInput);
                document.body.appendChild(form);
                form.submit();
            }
        });
    });

    // Показать QR-код клиента
    window.showQrCode = function(customerId, customerName, customerPhone) {
        // Генерируем данные для QR-кода
        var qrData = JSON.stringify({
            type: 'customer',
            customer_id: customerId,
            phone: customerPhone
        });

        // Используем API для генерации QR-кода
        var qrCodeUrl = 'https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=' + encodeURIComponent(qrData);

        document.getElementById('qrCodeImage').src = qrCodeUrl;
        document.getElementById('qrCodeCustomerName').textContent = customerName;
        document.getElementById('qrCodeCustomerPhone').textContent = customerPhone;

        var modal = new bootstrap.Modal(document.getElementById('qrCodeModal'));
        modal.show();
    };

    // Печать QR-кода
    window.printQrCode = function() {
        var printWindow = window.open('', '', 'height=400,width=400');
        var qrSrc = document.getElementById('qrCodeImage').src;
        var name = document.getElementById('qrCodeCustomerName').textContent;
        var phone = document.getElementById('qrCodeCustomerPhone').textContent;

        printWindow.document.write('<html><head><title>QR-код</title>');
        printWindow.document.write('<style>');
        printWindow.document.write('body { font-family: Arial, sans-serif; text-align: center; padding: 20px; }');
        printWindow.document.write('img { max-width: 200px; margin: 10px; }');
        printWindow.document.write('h3 { margin: 10px 0 5px; font-size: 16px; }');
        printWindow.document.write('p { margin: 0; color: #666; }');
        printWindow.document.write('</style></head><body>');
        printWindow.document.write('<img src="' + qrSrc + '" alt="QR-код">');
        printWindow.document.write('<h3>' + name + '</h3>');
        printWindow.document.write('<p>' + phone + '</p>');
        printWindow.document.write('</body></html>');

        printWindow.document.close();
        printWindow.print();
    };

    // Обработка кнопок показа QR-кода
    document.querySelectorAll('.show-qr-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var couponId = this.dataset.couponId;
            var couponCode = this.dataset.couponCode;
            var customerName = this.dataset.customerName;
            var customerPhone = this.dataset.customerPhone;

            // Генерируем данные для QR-кода (купон)
            var qrData = JSON.stringify({
                type: 'coupon',
                coupon_id: couponId,
                code: couponCode
            });

            // Используем API для генерации QR-кода
            var qrCodeUrl = 'https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=' + encodeURIComponent(qrData);

            document.getElementById('qrCodeImage').src = qrCodeUrl;
            document.getElementById('qrCodeCustomerName').textContent = customerName + ' (' + couponCode + ')';
            document.getElementById('qrCodeCustomerPhone').textContent = customerPhone || '';

            var modal = new bootstrap.Modal(document.getElementById('qrCodeModal'));
            modal.show();
        });
    });
});

// Сброс пароля клиента
function resetPassword() {
    const customerId = document.getElementById('editCouponId').value;
    if (!customerId) return;
    
    if (!confirm('Сгенерировать новый пароль для клиента?')) return;
    
    fetch(`/admin/customers/${customerId}/reset-password`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content
        }
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            alert('Новый пароль: ' + data.password + '\n\nСообщите этот пароль клиенту!');
        } else {
            alert('Ошибка: ' + data.message);
        }
    })
    .catch(err => alert('Ошибка сети: ' + err));
}
</script>

{{-- Модальное окно просмотра QR-кода --}}
<div class="modal fade" id="qrCodeModal" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-qr-code"></i>
                    QR-код клиента
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <img id="qrCodeImage" src="" alt="QR-код" class="img-fluid mb-3" style="max-width: 200px;">
                <h6 class="fw-bold mb-1" id="qrCodeCustomerName"></h6>
                <p class="text-muted mb-0" id="qrCodeCustomerPhone"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-primary" onclick="printQrCode()">
                    <i class="bi bi-printer"></i> Печать
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Закрыть</button>
            </div>
        </div>
    </div>
</div>
@endsection
